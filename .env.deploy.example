# Copy this file to .env for Docker Compose deployment.
# IMPORTANT: Change all secret values below before deploying to production.

# Public ports on the host machine.
FRONTEND_PORT=5173
BACKEND_PORT=8000
PUBLIC_ORIGIN=http://localhost:5173

# Backend container runtime.
MEDBOT_DB_PATH=/data/medbot.db
AGENT_BASE_URL=http://agent:8011
AGENT_ENV_PATH=/app/agent/.env

# ── Auth Tokens ──────────────────────────────────
# The agent and backend share a service token for internal API calls.
# MUST be the same on both sides. Generate a strong random value for production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEDBOT_SERVICE_TOKEN=change-me-in-production
AGENT_TOKEN=change-me-in-production
# ─────────────────────────────────────────────────

# Email (Exchange EWS) — fill in your Exchange credentials
MEDBOT_EMAIL_SERVER=mail.microport.com.cn
MEDBOT_EMAIL_USER=
MEDBOT_EMAIL_PASSWORD=

# Frontend production build. The compose file builds the browser bundle with /api.
VITE_API_BASE_URL=/api
