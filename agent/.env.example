PI_PROVIDER=openai
OPENAI_API_KEY=
# For DeepSeek, set PI_PROVIDER=deepseek and use DEEPSEEK_API_KEY instead.
DEEPSEEK_API_KEY=
# For 阿里云百炼 / 通义千问 (DashScope), set PI_PROVIDER=bailian and use DASHSCOPE_API_KEY.
# Works for BOTH the backend email/reply AI (services.py) and the Pi conversational
# sidecar (via an OpenAI-compatible model targeting the DashScope endpoint).
# The sidecar reads .env only at startup — restart the agent after changing this.
DASHSCOPE_API_KEY=
PI_MODEL=gpt-5-mini
BACKEND_BASE_URL=http://localhost:8000
# Must match the backend's MEDBOT_SERVICE_TOKEN so the agent can call the RBAC-protected API.
BACKEND_SERVICE_TOKEN=
AGENT_HOST=127.0.0.1
AGENT_PORT=8011
AGENT_CORS_ORIGIN=http://localhost:5173
AGENT_MAX_BODY_BYTES=65536
AGENT_TOKEN=
AGENT_MAX_SESSIONS=20
AGENT_SESSION_IDLE_MS=1800000
